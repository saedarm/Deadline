# Server settings. Locally: copy to .env and `source` it, or export these.
# On Fly: `fly secrets set NAME=value` for the secret ones.

# Shared secret ("press pass"). Generate one: openssl rand -hex 24
DEADLINE_TOKEN=

# Google Calendar > Settings > (your calendar) > "Secret address in iCal format".
# Several calendars: separate with commas.
CALENDAR_ICS_URLS=

# Todoist > Settings > Integrations > Developer > API token. Only needed for the import.
TODOIST_TOKEN=

DEADLINE_TZ=America/New_York
DEADLINE_DB=deadline.db
PORT=8080
